scanBases = function()
	clearGui(Flc.scroll)
	local plots = workspace:FindFirstChild("Plots")
	if not plots then FleeceInfo.Text = "no Plots folder found"; return end
	local owners = {}
	for _, plot in ipairs(plots:GetChildren()) do
		local list, total, ogs, bestE = {}, 0, 0, nil
		for _, d in ipairs(plot:GetDescendants()) do
			if d:IsA("Model") then
				local nm, e = animalNameOf(d)
				if nm then
					list[nm] = list[nm] or {n = 0, og = e ~= nil}
					list[nm].n += 1
					total += 1
					if e then
						ogs += 1
						e.models[d] = true
						if not bestE or e.prio < bestE.prio then bestE = e end
					end
				end
			end
		end
		if total > 0 then
			local owner = plotOwner(plot)
			table.insert(owners, {owner = owner, plr = playerByName(owner), list = list, total = total, ogs = ogs, best = bestE})
		end
	end
	table.sort(owners, function(a, b)
		if a.ogs ~= b.ogs then return a.ogs > b.ogs end
		return a.total > b.total
	end)
	local ogBases = 0
	for i, o in ipairs(owners) do
		if o.ogs > 0 then ogBases += 1 end
		local parts = {}
		for nm, v in pairs(o.list) do
			local s = nm .. (v.n > 1 and (" ×" .. v.n) or "")
			table.insert(parts, v.og and ("<font color=\"#BE78FF\"><b>" .. s .. "</b></font>") or s)
		end
		local card = new("Frame", {BackgroundColor3 = C.panel, BackgroundTransparency = GLASS, Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = i, Parent = Flc.scroll}, {corner(10), pad(10, 10, 10, 10)})
		stroke(o.ogs > 0 and C.accent or C.stroke, 1, o.ogs > 0 and .3 or 0).Parent = card
		if o.plr then
			new("ImageLabel", {Image = avatarOf(o.plr.UserId), BackgroundColor3 = C.card2, Size = UDim2.fromOffset(28, 28),
