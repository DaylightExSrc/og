local boardSig = setmetatable({}, {__mode = "k"})
local boardHooks = {}

findBoard = function()
	if BOARD_PATH then return resolvePath(BOARD_PATH) end
	local function check(root)
		if not root then return nil end
		for _, d in ipairs(root:GetDescendants()) do
			local k = normalize(d.Name)
			for _, n in ipairs(BOARD_NAMES) do if k:find(n, 1, true) then return d end end
		end
	end
	return check(workspace) or check(LP:FindFirstChild("PlayerGui"))
end

local function textsUnder(inst)
	local t = {}
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
			local s = d.ContentText ~= "" and d.ContentText or d.Text
			if s ~= "" then table.insert(t, s) end
		end
	end
	return t
end

scanBoard = function()
	if not board or not board.Parent then return end
	local batch = {}
	for _, d in ipairs(board:GetDescendants()) do
		if d:IsA("TextLabel") or d:IsA("TextButton") then
			local e = matchInText(d.ContentText ~= "" and d.ContentText or d.Text)
			if e then
				local row, plr, texts = d.Parent, nil, {}
				for _ = 1, 3 do
					if not row or row == board then break end
					texts = textsUnder(row)
					plr = playerFromTexts(texts)
					if plr or row.Parent == board then break end
					row = row.Parent
				end
				if row and row ~= board then
					local sig = e.key .. "|" .. table.concat(texts, "|")
					if boardSig[row] ~= sig then
						boardSig[row] = sig
						local rawWho
						for _, s in ipairs(texts) do
							if not matchInText(s) and s:find("^@?[%w_]+$") and #s >= 3 then rawWho = s; break end
						end
						table.insert(batch, {entry = e, player = plr, rawWho = rawWho, t = os.clock(), old = not boardBoot})
					end
				end
			end
		end
	end
	if #batch == 0 then boardBoot = true; return end

	table.sort(batch, function(a, b) return a.entry.prio < b.entry.prio end)
	for _, be in ipairs(batch) do
		eventId += 1
		be.id = eventId
		table.insert(boardEntries, 1, be)
		if not be.old then
			pushEvent({name = be.entry.name, t = be.t, og = true, entry = be.entry, player = be.player, kind = "board"})
		end
	end
	while #boardEntries > 80 do table.remove(boardEntries) end

	-- instant trade (skip whatever was already on the board when we hooked it)
	if S.autoTrade and boardBoot then
		for _, be in ipairs(batch) do
			if be.player and not be.old then
				sendTrade(be.player, be.entry.name)
				if S.bestOnly then break end
			end
		end
	end
	boardBoot = true
	rebuildBoardList()
end

hookBoard = function(b)
	for _, c in ipairs(boardHooks) do c:Disconnect() end
	table.clear(boardHooks)
	board, boardBoot = b, false
	table.insert(boardHooks, b.DescendantAdded:Connect(function() task.defer(scanBoard) end))
	for _, d in ipairs(b:GetDescendants()) do
		if d:IsA("TextLabel") then
			table.insert(boardHooks, d:GetPropertyChangedSignal("Text"):Connect(function() task.defer(scanBoard) end))
		end
	end
	table.insert(boardHooks, b.DescendantAdded:Connect(function(d)
		if d:IsA("TextLabel") then
			table.insert(boardHooks, d:GetPropertyChangedSignal("Text"):Connect(function() task.defer(scanBoard) end))
		end
	end))
	scanBoard()
end

local function setBoardStatus()
	local ok = board and board.Parent
	BoardStatus.Text = ok and ("connected · " .. board.Name) or "searching..."
	BoardStatus.TextColor3 = ok and C.on or C.sub
	BoardDot.BackgroundColor3 = ok and C.on or C.dim
	boardDesc.Text = ok and board:GetFullName() or "not found — set BOARD_PATH"
	boardDesc.TextColor3 = ok and C.on or C.danger
end

task.spawn(function()
	while running do
		if not board or not board:IsDescendantOf(game) then
			local b = findBoard()
			if b then
				hookBoard(b)
				notify("LIVEBOARD FOUND", b.Name, nil, "trade")
			else
				board = nil
			end
			setBoardStatus()
			if not b then
				tw(BoardDot, .6, {BackgroundTransparency = .7}, Enum.EasingStyle.Sine)
				task.wait(.6)
				tw(BoardDot, .6, {BackgroundTransparency = 0}, Enum.EasingStyle.Sine)
				task.wait(2.4)
			end
		else
			scanBoard() -- catches rows that change without firing events
			task.wait(1)
		end
	end
end)

------------------------------------------------------------------ LAYOUT
local function detectMode()
	if S.layout == "PC" then return "top" end
	if S.layout == "MOBILE" then return "side" end
	local vp = Camera.ViewportSize
	if not UIS.TouchEnabled then return "top" end
	if UIS.KeyboardEnabled and vp.X >= 1000 then return "top" end
	return "side"
end

applyLayout = function(anim)
	mode = detectMode()
	local t = anim and .3 or 0
	local top = mode == "top"
	local size = top and UDim2.fromOffset(460, 600) or UDim2.fromOffset(570, 320)
	tw(Main, t, {Size = size})
	SubTitle.Text = top and "pc" or "mobile"
	CollapseBtn.Visible = not top
	TabLayout.FillDirection = top and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
	TabList.ScrollingDirection = top and Enum.ScrollingDirection.X or Enum.ScrollingDirection.Y
	TabList.AutomaticCanvasSize = top and Enum.AutomaticSize.X or Enum.AutomaticSize.Y
	TabList.CanvasSize = UDim2.new()
	TabList.ScrollBarThickness = top and 0 or 2
	if top then
		tw(Rail, t, {Size = UDim2.new(1, -16, 0, 38)})
		TabList.Position = UDim2.fromOffset(4, 4)
		TabList.Size = UDim2.new(1, -8, 1, -8)
		tw(Content, t, {Position = UDim2.fromOffset(8, 52), Size = UDim2.new(1, -16, 1, -60)})
	else
		local w = S.collapsed and 46 or 128
		tw(Rail, t, {Size = UDim2.new(0, w, 1, -14)})
		TabList.Position = UDim2.fromOffset(5, 40)
		TabList.Size = UDim2.new(1, -10, 1, -46)
		tw(Content, t, {Position = UDim2.fromOffset(w + 16, 7), Size = UDim2.new(1, -(w + 24), 1, -14)})
		CollapseBtn.Text = S.collapsed and "»" or "«  collapse"
	end
	for _, def in ipairs(TAB_DEFS) do
		local tb = Tabs[def.id]
		if top then
			local tx = TextService:GetTextSize(def.id, 11, F, Vector2.new(400, 40)).X
			tb.btn.Size = UDim2.new(0, tx + 22, 1, 0)
			tb.icon.Visible = false
			tb.label.Position = UDim2.new()
			tb.label.Size = UDim2.fromScale(1, 1)
			tb.label.TextXAlignment = Enum.TextXAlignment.Center
			tb.label.TextTransparency = 0
			tb.ind.AnchorPoint = Vector2.new(.5, 1)
			tb.ind.Position = UDim2.new(.5, 0, 1, -2)
			tb.ind.Size = UDim2.new(1, -16, 0, 2)
		else
			tb.btn.Size = UDim2.new(1, 0, 0, 30)
			tb.icon.Visible = true
			tb.label.TextXAlignment = Enum.TextXAlignment.Left
			tb.label.Position = UDim2.fromOffset(32, 0)
			tb.label.Size = UDim2.new(1, -34, 1, 0)
			tb.ind.AnchorPoint = Vector2.new(0, .5)
			tb.ind.Position = UDim2.new(0, 0, .5, 0)
			tb.ind.Size = UDim2.fromOffset(3, 14)
			if S.collapsed then
				tw(tb.icon, t, {Size = UDim2.fromScale(1, 1)})
				tw(tb.label, t * .5, {TextTransparency = 1})
			else
				tw(tb.icon, t, {Size = UDim2.new(0, 30, 1, 0)})
				tw(tb.label, t, {TextTransparency = 0})
			end
		end
	end
	local vp = Camera.ViewportSize
	local fit = math.min((vp.X - 20) / size.X.Offset, (vp.Y - 20) / size.Y.Offset, 1)
	targetScale = math.max(fit, .4) * S.uiScale
	if not minimized then tw(MainScale, t, {Scale = targetScale}) end
	NotifyScale.Scale = math.clamp(vp.X / 900, .75, 1)
end

