------------------------------------------------------------------ TRADE SYSTEM
local tradeRemote
local function resolvePath(path)
	local node = game
	for _, seg in ipairs(path) do
		node = node:FindFirstChild(seg)
		if not node then return nil end
	end
	return node
end
local function resolveTradeRemote()
	if TRADE.path then
		local r = resolvePath(TRADE.path)
		if r then tradeRemote = r; return r end
	end
	local best, bestScore
	for _, d in ipairs(RS:GetDescendants()) do
		if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
			local n = d.Name:lower()
			if n:find("trade") then
				local s = 1
				for _, w in ipairs({"send", "request", "invite", "offer", "start"}) do if n:find(w) then s += 2 end end
				for _, w in ipairs({"accept", "decline", "cancel", "ready", "confirm", "update", "remove", "add", "set"}) do
					if n:find(w) then s -= 3 end
				end
				if not bestScore or s > bestScore then best, bestScore = d, s end
			end
		end
	end
	tradeRemote = best
	return best
end

local lastTrade = {}
sendTrade = function(plr, animalName)
	if typeof(plr) ~= "Instance" or not plr.Parent then return false, "offline" end
	if plr == LP then return false, "self" end
	local last = lastTrade[plr.UserId]
	if last and os.clock() - last < S.tradeCooldown then return false, "cooldown" end
	local r = (tradeRemote and tradeRemote.Parent and tradeRemote) or resolveTradeRemote()
	if not r then
		notify("NO TRADE REMOTE", "set TRADE.path at the top of the script", nil, "danger")
		return false, "no remote"
	end
	lastTrade[plr.UserId] = os.clock()
	local args = table.pack(TRADE.args(plr, animalName))
	task.spawn(function()
		local ok, err = pcall(function()
			if r:IsA("RemoteFunction") then
				r:InvokeServer(table.unpack(args, 1, args.n))
			else
				r:FireServer(table.unpack(args, 1, args.n))
			end
		end)
		if not ok then notify("TRADE FAILED", tostring(err):sub(1, 60), nil, "danger") end
	end)
	stats.trades += 1
	notify("TRADE SENT", "@" .. plr.Name .. (animalName and (" · " .. animalName) or ""), avatarOf(plr.UserId), "trade")
	updateCounters()
	return true
end

local function tradeButton(parent, plr, animalName, w)
	local b, lbl = primary(parent, "TRADE", w or 64, 26)
	b.AnchorPoint = Vector2.new(1, .5)
	b.Position = UDim2.new(1, -10, .5, 0)
	b.MouseButton1Click:Connect(function()
		local ok, why = sendTrade(plr, animalName)
		lbl.Text = ok and "SENT" or string.upper(why or "fail")
		task.delay(2.5, function() if lbl.Parent then lbl.Text = "TRADE" end end)
	end)
	return b, lbl
end

