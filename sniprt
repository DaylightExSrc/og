local seen = setmetatable({}, {__mode = "k"})

local function pushEvent(evt)
	eventId += 1
	evt.id = eventId
	table.insert(events, 1, evt)
	if #events > 200 then table.remove(events) end
	stats.seen += 1
	if evt.og then
		stats.og += 1
		evt.entry.seen += 1
		evt.entry.last = evt.t
		CaughtScale.Scale = 1.2
		tw(CaughtScale, .45, {Scale = 1}, Enum.EasingStyle.Back)
		if S.auto then
			notify(evt.kind == "board" and "OG ON LIVEBOARD" or "OG SPAWNED",
				evt.name .. (evt.player and (" · @" .. evt.player.Name) or ""), evt.model or evt.name, "og")
		end
		if S.autoOpen and minimized then openGui() end
	elseif S.auto and S.notifyAll then
		notify("spawn", evt.name, evt.model, "info")
	end
	updateCounters()
	if evt.id > feedFloor then eventCard(Feed.scroll, evt, feedCards); FeedEmpty.Visible = false end
	if evt.id > liveFloor and (evt.og or S.allLogs) then eventCard(Live.scroll, evt, liveCards); LiveEmpty.Visible = false end
	refreshOG()
end

local function onModel(m)
	if not running or seen[m] then return end
	if not m:IsA("Model") or not m:IsDescendantOf(workspace) then return end
	if Players:GetPlayerFromCharacter(m) then return end
	local nm, entry = animalNameOf(m)
	if not nm then return end
	local p = m.Parent
	if p and p:IsA("Model") and seen[p] and normalize(rawName(p)) == normalize(rawName(m)) then return end
	seen[m] = true
	liveByKey[normalize(nm)] = m
	if entry then entry.models[m] = true end
	if plotOf(m) then return end
	pushEvent({name = nm, model = m, t = os.clock(), og = entry ~= nil, entry = entry, kind = "spawn"})
end

fullScan = function()
	for _, d in ipairs(workspace:GetDescendants()) do if d:IsA("Model") then onModel(d) end end
end
bind(workspace.DescendantAdded, function(d) if d:IsA("Model") then task.defer(onModel, d) end end)

