local function makeDraggable(handle, target, onClick)
	local dragging, moved, startIn, startPos = false, false, nil, nil
	handle.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, moved, startIn, startPos = true, false, i.Position, target.Position
			local c
			c = i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					dragging = false
					c:Disconnect()
					if not moved and onClick then onClick() end
				end
			end)
		end
	end)
	bind(UIS.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - startIn
			if math.abs(d.X) + math.abs(d.Y) > 5 then moved = true end
			if moved then
				target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end
	end)
end
makeDraggable(Header, Main)
makeDraggable(FloatBtn, FloatBtn, function() openGui() end)

bind(UIS.InputBegan, function(i, gp)
	if gp then return end
	if i.KeyCode == TOGGLE_KEY then if minimized then openGui() else closeGui() end end
end)

------------------------------------------------------------------ LOOPS
bind(RunService.Heartbeat, function(dt)
	for i = #spinGrads, 1, -1 do
		local g = spinGrads[i]
		if not g.Parent then table.remove(spinGrads, i) else g.Rotation = (g.Rotation + dt * 90) % 360 end
	end
	if minimized then return end
	for i = #spinners, 1, -1 do
		local s = spinners[i]
		if not s.vf.Parent then
			table.remove(spinners, i)
		else
			s.a += dt * .8
			s.cam.CFrame = CFrame.lookAt(s.center + Vector3.new(math.sin(s.a) * s.dist, s.h, math.cos(s.a) * s.dist), s.center)
		end
	end
end)

task.spawn(function()
