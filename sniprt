local function merge(a, b)
	local t = {}
	for k, v in pairs(a) do t[k] = v end
	for k, v in pairs(b or {}) do t[k] = v end
	return t
end
local function new(class, props, kids)
	local o = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do if k == "Parent" then parent = v else o[k] = v end end
	for _, c in ipairs(kids or {}) do c.Parent = o end
	if parent then o.Parent = parent end
	return o
end
local function corner(r) return new("UICorner", {CornerRadius = UDim.new(0, r or 8)}) end
local function stroke(col, th, tr)
	return new("UIStroke", {Color = col or C.stroke, Thickness = th or 1, Transparency = tr or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border})
end
local function pad(l, r, t, b)
	return new("UIPadding", {PaddingLeft = UDim.new(0, l or 0), PaddingRight = UDim.new(0, r or l or 0),
		PaddingTop = UDim.new(0, t or 0), PaddingBottom = UDim.new(0, b or t or 0)})
end
local function tw(o, t, props, style, dir)
	local x = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	x:Play()
	return x
end
local function label(p)
	return new("TextLabel", merge({BackgroundTransparency = 1, Font = F, TextColor3 = C.text, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center}, p))
end
local function normalize(s) return (string.lower(tostring(s or "")):gsub("[%s%p_]", "")) end
local function ago(t)
	local d = math.max(0, math.floor(os.clock() - t))
	if d < 60 then return d .. "s ago" end
	if d < 3600 then return math.floor(d / 60) .. "m ago" end
	return math.floor(d / 3600) .. "h ago"
end
local function shortName(name)
	if #name <= 9 then return name:upper() end
	local w = {}
	for x in name:gmatch("%S+") do table.insert(w, x) end
	if #w < 2 then return name:sub(1, 9):upper() end
	return (w[1]:sub(1, 1) .. "." .. w[#w]:sub(1, 6)):upper()
end
