local function matchInText(t)
	local k = normalize(t)
	if k == "" then return nil end
	for _, e in ipairs(tracked) do if k:find(e.key, 1, true) then return e end end
end
local function rawName(m) return tostring(m:GetAttribute("AnimalName") or m:GetAttribute("Index") or m.Name) end
local function animalNameOf(m)
	local raw = rawName(m)
	local e = matchTracked(raw)
	if e then return e.name, e end
	local k = knownAnimals[normalize(raw)]
	if k then return k end
end
local function plotOf(m)
	local p = m
	while p and p.Parent and p.Parent ~= workspace do
		if p.Parent.Name == "Plots" then return p end
		p = p.Parent
	end
end
local function plotOwner(plot)
	local a = plot:GetAttribute("Owner") or plot:GetAttribute("OwnerName")
	if a then return tostring(a) end
	local v = plot:FindFirstChild("Owner")
	if v and v:IsA("ObjectValue") and v.Value then return v.Value.Name end
	if v and v:IsA("StringValue") and v.Value ~= "" then return v.Value end
	for _, d in ipairs(plot:GetDescendants()) do
		if d:IsA("TextLabel") and d.Text:find("'s Base") then return (d.Text:gsub("'s Base.*", "")) end
	end
	return plot.Name
end
local function playerFromTexts(texts)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP then
			local n, dn = normalize(p.Name), normalize(p.DisplayName)
			for _, t in ipairs(texts) do
				local k = normalize(t)
				if k ~= "" and (k == n or k == dn or (#n >= 4 and k:find(n, 1, true)) or (#dn >= 4 and k:find(dn, 1, true))) then
					return p
				end
			end
		end
	end
end
local function playerByName(name)
	local k = normalize(name)
	for _, p in ipairs(Players:GetPlayers()) do
		if normalize(p.Name) == k or normalize(p.DisplayName) == k then return p end
	end
end
local function countLive(e)
	local n = 0
	for m in pairs(e.models) do if m.Parent and m:IsDescendantOf(workspace) then n += 1 end end
	return n
end

