local function stepperRow(parent, order, title, desc, key, min, max, step, fmt, onChange)
	local r = rowFrame(parent, order)
	rowText(r, title, desc)
	local plus = ghost(r, "+", 28, 26, "accent")
	plus.AnchorPoint = Vector2.new(1, .5)
	plus.Position = UDim2.new(1, -10, .5, 0)
	local val = label({Font = FB, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(1, .5),
		Position = UDim2.new(1, -40, .5, 0), Size = UDim2.fromOffset(46, 26), Parent = r})
	local minus = ghost(r, "–", 28, 26, "accent")
	minus.AnchorPoint = Vector2.new(1, .5)
	minus.Position = UDim2.new(1, -88, .5, 0)
	local function set(v)
		S[key] = math.clamp(math.floor(v / step + .5) * step, min, max)
		if onChange then onChange(S[key]) end
		sync()
	end
	plus.MouseButton1Click:Connect(function() set(S[key] + step) end)
	minus.MouseButton1Click:Connect(function() set(S[key] - step) end)
	table.insert(syncers, function() val.Text = string.format(fmt, S[key]) end)
	return r
end
local function buttonRow(parent, order, title, desc, btns)
