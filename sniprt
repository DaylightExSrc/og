local animalRoots, knownAnimals, modelCache, liveByKey = {}, {}, {}, {}

for _, path in ipairs(ANIMAL_PATHS) do
	local node = RS
	for _, seg in ipairs(path) do node = node and node:FindFirstChild(seg) end
	if node and not node:IsA("LuaSourceContainer") then
		table.insert(animalRoots, node)
		for _, m in ipairs(node:GetChildren()) do
			if m:IsA("Model") then knownAnimals[normalize(m.Name)] = m.Name end
		end
	end
end

local function findModel(name)
	local key = normalize(name)
	if key == "" then return nil end
	if modelCache[key] then return modelCache[key] end
	local fuzzy
	local function scan(list)
		for _, d in ipairs(list) do
			if d:IsA("Model") then
				local k = normalize(d.Name)
				if k == key then return d end
				if not fuzzy and #k >= 4 and #key >= 4 and (k:find(key, 1, true) or key:find(k, 1, true)) then fuzzy = d end
			end
		end
	end
	local hit
	for _, root in ipairs(animalRoots) do hit = hit or scan(root:GetDescendants()) end
	hit = hit or scan(RS:GetDescendants()) or fuzzy
	if hit then modelCache[key] = hit; return hit end
	local live = liveByKey[key]
	if live and live.Parent then return live end
	return nil
end

local function cloneModel(m)
	local ok, c = pcall(function()
		local arch = m.Archivable
		m.Archivable = true
		local cl = m:Clone()
		m.Archivable = arch
		return cl
	end)
	if not ok or not c then return nil end
	if c:IsA("Tool") or c:IsA("Accessory") then
		local mdl = Instance.new("Model")
		for _, ch in ipairs(c:GetChildren()) do ch.Parent = mdl end
		c = mdl
	end
	for _, d in ipairs(c:GetDescendants()) do
		if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("BillboardGui") or d:IsA("Highlight")
			or d:IsA("ProximityPrompt") or d:IsA("SurfaceGui") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	return c
end

local spinners = {}
local function makeViewport(parent, src, size, spin)
	local vf = new("ViewportFrame", {BackgroundColor3 = C.card2, BackgroundTransparency = .3, Size = size,
		Ambient = Color3.fromRGB(190, 170, 220), LightColor = C.white, LightDirection = Vector3.new(-1, -1, -1),
		Parent = parent}, {corner(10)})
	local clone
	if typeof(src) == "Instance" then
		clone = cloneModel(src)
		if not clone then local alt = findModel(src.Name); clone = alt and cloneModel(alt) end
	elseif src then
		local m = findModel(src)
		clone = m and cloneModel(m)
	end
	if not clone then
		label({Text = "?", Font = FB, TextSize = 18, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1), Parent = vf})
		return vf, false
	end
	clone.Parent = vf
	local ok, cf, sz = pcall(function() return clone:GetBoundingBox() end)
	if not ok then return vf, false end
	local cam = new("Camera", {FieldOfView = 35, Parent = vf})
	vf.CurrentCamera = cam
	local r = math.max(sz.Magnitude * .5, .5)
	local dist = r / math.tan(math.rad(17.5)) * 1.02
	local center, look = cf.Position, cf.LookVector
	local h = r * .25
	cam.CFrame = CFrame.lookAt(center + look * dist + Vector3.new(0, h, 0), center)
	if spin then
		table.insert(spinners, {vf = vf, cam = cam, center = center, dist = dist, h = h, a = math.atan2(look.X, look.Z)})
	end
	return vf, true
end

