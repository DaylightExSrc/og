local function pressFx(b, st)
	local sc = new("UIScale", {Parent = b})
	local base
	b.MouseEnter:Connect(function()
		if st then base = base or st.Color; tw(st, .15, {Color = base:Lerp(C.white, .3)}) end
		tw(sc, .15, {Scale = 1.03})
	end)
	b.MouseLeave:Connect(function()
		if st and base then tw(st, .15, {Color = base}) end
		tw(sc, .15, {Scale = 1})
	end)
	b.MouseButton1Down:Connect(function() tw(sc, .08, {Scale = .92}) end)
	b.MouseButton1Up:Connect(function() tw(sc, .35, {Scale = 1}, Enum.EasingStyle.Back) end)
end

